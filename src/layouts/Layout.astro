---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'Portfolio Profesional' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Desarrollador Senior Full-Stack especializado en desarrollo de software, automatización, marketing y análisis financiero." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TridentOps" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="TridentOps" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-gray-100 antialiased selection:bg-blue-600 selection:text-white">
    <slot />
  </body>
</html>
