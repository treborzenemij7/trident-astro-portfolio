---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'TRIDENTOPS | Ingeniería, Finanzas y Automatización Avanzada',
  description = 'TRIDENTOPS: Ingeniería de software de misión crítica, modelado financiero algorítmico y automatización estratégica avanzada.'
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/tridentops-logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-[#111827] text-[#F3F4F6] font-manrope antialiased selection:bg-[#A3E635] selection:text-[#111827]">
    <slot />
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
      if (typeof AOS !== 'undefined') {
        AOS.init({ duration: 900, once: true, easing: 'ease-out-cubic' });
      }
    </script>
  </body>
</html>
